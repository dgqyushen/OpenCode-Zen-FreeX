# Every variable the maintenance scripts read, with the default each one falls
# back to when it is unset. Copy this to `.env` and edit, or export them in the
# shell you run the scripts from — nothing here loads a file by itself, and
# nothing in the package reads an API key: the Zen free tier's credential is
# the literal string `public`.
#
#   bun run check:gate   /   bun run limits:audit   /   bun run capture

# check:gate — which model the gate probes Zen with, and which endpoint it asks.
# ZEN_BASE_URL=https://opencode.ai/inference/v1
# ZEN_CHECK_MODEL=space-bunny-free

# limits:audit — the same endpoint override, plus where the catalogue is read
# from and which captured generation the audit asks as.
# ZEN_BASE_URL=https://opencode.ai/inference/v1
# ZEN_CATALOG_URL=https://models.opencode.ai/api.json
# ZEN_GENERATION=1.x

# capture — the loopback port the capture server binds while a real OpenCode is
# pointed at it. Nothing leaves the machine: the request OpenCode makes is what
# is being read, not answered.
# CAPTURE_PORT=8791
