{
  "name": "opencode-zen-freex",
  "version": "0.2.41",
  "description": "OpenCode Zen's free models, for hosts that are not OpenCode: the public credential, automatic discovery and native streaming protocols",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./index.mjs": "./index.mjs",
    "./provider.mjs": "./provider.mjs",
    "./core-tools.mjs": "./core-tools.mjs",
    "./models.mjs": "./models.mjs",
    "./limits.mjs": "./limits.mjs",
    "./stream.mjs": "./stream.mjs",
    "./tool-response.mjs": "./tool-response.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "provider.mjs",
    "core-tools.mjs",
    "fingerprint.json",
    "limits.mjs",
    "limits-observed.json",
    "models.mjs",
    "stream.mjs",
    "tool-response.mjs",
    "README.md",
    "MAINTAINING.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "zen",
    "free",
    "magpie"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkhs101/OpenCode-Zen-FreeX.git"
  },
  "bugs": {
    "url": "https://github.com/tkhs101/OpenCode-Zen-FreeX/issues"
  },
  "homepage": "https://github.com/tkhs101/OpenCode-Zen-FreeX#readme",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "test": "bun test",
    "check:gate": "bun tools-smoke.mjs",
    "limits:audit": "bun limits-audit.mjs",
    "capture": "bun capture.mjs",
    "limits:sweep": "bun limits-sweep.mjs",
    "limits:watch": "bun limits-watch.mjs"
  },
  "packageManager": "bun@1.4.3",
  "magpie": {
    "icon": "https://opencode.ai/favicon-v3.ico",
    "maxConcurrency": 2
  }
}
